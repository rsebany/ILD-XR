# Node / Next.js
node_modules/
.next/
frontend/.next/
frontend/node_modules/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Environment / secrets (do NOT commit)
*.env
*.env.*
!.env.example
backend-api/.env
frontend/.env
frontend/.env.*
!frontend/.env.example

# Local data / outputs
backend-api/data/
backend-ai/weights/
backend-api/static/meshes/
backend-api/tmp/

# Model binaries (download from GitHub Releases; see weights/README.md)
backend-api/weights/*.pth
!backend-api/weights/README.md
!backend-api/weights/.gitkeep

# Notebooks: keep sources, ignore checkpoints / local secrets
Experimentations/.ipynb_checkpoints/
Experimentations/local.env
Experimentations/Results/
**/checkpoint/

# Per-patient / path-leaking runtime CSVs (aggregate JSON summaries may stay tracked)
backend-api/results/*_patients.csv
backend-api/results/*_mask_audit.csv
backend-api/results/*_biomarker.csv

# Local paper/export artifacts (do not push)
shared/config/evaluation-metrics.json
shared/figures/

venv/

# Logs
*.log

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
